# Application
APP_ADDR=:8080

# Platform Database (PostgreSQL for metadata)
# Format: postgres://user:***@host:port/database?sslmode=disable
PLATFORM_DATABASE_URL=postgres://admin:***@localhost:56732/platform_db?sslmode=disable
PUBLIC_ORIGIN=http://localhost:6767

# Database Credential Encryption Key (base64-encoded 32-byte key for AES-256-GCM)
# Generate with: openssl rand -base64 32
DB_CREDENTIAL_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Session Configuration
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=24h
SESSION_ROTATION_INTERVAL=15m
SESSION_GRACE_PERIOD=30s

# Query Limits
QUERY_TIMEOUT=5s
QUERY_MAX_ROWS=100

# PostgreSQL migration queue and Go worker
JOBS_CONCURRENCY=4
JOBS_POLL_INTERVAL=1s
JOBS_HEARTBEAT_INTERVAL=5s
JOBS_LEASE_DURATION=30s
JOBS_EXECUTION_TIMEOUT=1h
JOBS_RETRY_BASE_DELAY=1s
JOBS_RETRY_MAX_DELAY=1m
JOBS_MAX_ATTEMPTS=5
JOBS_SHUTDOWN_TIMEOUT=30s
